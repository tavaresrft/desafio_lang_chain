# Provedor: openai ou gemini
LLM_PROVIDER=openai

# Preencha apenas a chave do provedor escolhido (nunca versione chaves reais).
OPENAI_API_KEY=
GEMINI_API_KEY=

# Modelos são configuráveis e podem mudar. Consulte as docs oficiais (README).
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_CHAT_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Banco local do docker-compose. DATABASE_URL deve ser compartilhada por ingestão e busca.
DATABASE_URL=postgresql+psycopg://langchain:langchain@localhost:5432/langchain
PGVECTOR_COLLECTION=documents

# Configuração usada pelo container PostgreSQL.
POSTGRES_DB=langchain
POSTGRES_USER=langchain
POSTGRES_PASSWORD=langchain
POSTGRES_PORT=5432
